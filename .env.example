# Copy to .env to override compose.dev.yml's dev infra defaults. Nothing here is required - the stack works with none of this set

# =============================================================================
# POSTGRES (compose.dev.yml)
# =============================================================================

#POSTGRES_DEV_USER="fluxbound"
#POSTGRES_DEV_PASSWORD="dev-data"
#POSTGRES_DEV_DB="fluxbound-dev"
#POSTGRES_DEV_PORT=5434

# =============================================================================
# STORAGE (compose.dev.yml)
# =============================================================================

#S3_DEV_ACCESS_KEY="dev-access-key"
#S3_DEV_SECRET_KEY="dev-secret-key"
#S3_DEV_BUCKET="fluxbound-dev"
#S3_DEV_PORT=8334
#S3_DEV_UI_PORT=8889
#S3_DEV_ADMIN_PORT=23647
