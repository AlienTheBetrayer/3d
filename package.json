{
  "name": "src",
  "private": true,
  "scripts": {
    "dev": "pnpm lint && pnpm test && turbo run dev",
    "build": "pnpm format && pnpm lint && turbo run build",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "pnpm exec vitest run",
    "test:watch": "pnpm --filter @repo/api test:watch",
    "test:cov": "pnpm --filter @repo/api test:cov",
    "test:e2e": "pnpm --filter @repo/api test:e2e"
  },
  "devDependencies": {
    "@repo/prettier-config": "workspace:*",
    "jsdom": "^30.0.1",
    "oxlint": "^1.81.0",
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2",
    "unplugin-swc": "^1.5.11",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
